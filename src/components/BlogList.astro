---
import type { CollectionEntry } from 'astro:content';
import { entrySlug } from '../lib/content';
import { formatDate } from '../lib/format';

type PostEntry = CollectionEntry<'blog'>;

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props as Props;
---

<ul class="border-y border-line/80">
  {
    posts.map((post) => (
      <li class="border-b border-line/80 py-8 last:border-b-0 sm:grid sm:grid-cols-[190px_minmax(0,1fr)] sm:gap-6">
        <time class="editorial-label block sm:pt-1" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <div class="mt-4 space-y-3 sm:mt-0">
          <h3 class="text-2xl font-semibold leading-tight tracking-[-0.035em]">
            <a class="hover:text-muted" href={`/blog/${entrySlug(post)}/`}>
              {post.data.title}
            </a>
          </h3>
          <p>{post.data.description}</p>
          <a
            class="inline-flex items-center gap-3 text-sm font-medium tracking-[0.08em] text-ink uppercase transition-transform duration-300 hover:translate-x-1"
            href={`/blog/${entrySlug(post)}/`}
          >
            Read Essay
            <span aria-hidden="true">/</span>
          </a>
        </div>
      </li>
    ))
  }
</ul>
