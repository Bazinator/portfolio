---
import BaseLayout from './BaseLayout.astro';
import Container from '../Container.astro';
import { formatDate } from '../../lib/format';

interface Props {
  description: string;
  title: string;
  date: Date;
  backHref?: string;
}

const { description, title, date, backHref = '/writing' } = Astro.props as Props;
---

<BaseLayout description={description} title={title}>
  <section class="border-b border-line/70 pt-28 pb-14 sm:pt-32 sm:pb-16">
    <Container narrow={true}>
      <a
        class="editorial-label inline-flex items-center gap-3 hover:text-ink"
        href={backHref}
      >
        <span class="text-accent" aria-hidden="true">/</span>
        Back to writing
      </a>
      <div class="mt-8 max-w-3xl space-y-5">
        <time class="editorial-label block" datetime={date.toISOString()}>
          {formatDate(date)}
        </time>
        <h1 class="page-title max-w-4xl">{title}</h1>
        <p class="body-large max-w-2xl">{description}</p>
      </div>
    </Container>
  </section>

  <section class="py-14 sm:py-16">
    <Container narrow={true}>
      <article class="prose-editorial">
        <slot />
      </article>
    </Container>
  </section>
</BaseLayout>
