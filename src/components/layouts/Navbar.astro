---
import Container from '../Container.astro';
import { navigation, site } from '../../data/site';

interface Props {
  pathname?: string;
}

const { pathname = '/' } = Astro.props as Props;

const isActive = (href: string) =>
  href === '/' ? pathname === '/' || pathname.startsWith('/about') : pathname.startsWith(href);
---

<header class="site-header fixed inset-x-0 top-0 z-40 border-b backdrop-blur-md lg:inset-auto lg:left-3 lg:top-5 lg:w-[132px] lg:rounded-xl lg:border lg:shadow-none lg:transition-all lg:duration-300 lg:hover:shadow-xl lg:hover:shadow-night/25">
  <Container class="lg:px-0">
    <div class="flex min-h-16 items-center justify-between gap-4 py-3 lg:min-h-0 lg:-translate-x-[30px] lg:flex-col lg:items-stretch lg:justify-start lg:gap-7 lg:px-3 lg:py-5">
      <div class="flex items-center gap-2 lg:w-full lg:justify-start">
        <button
          aria-label="Switch to light theme"
          aria-pressed="false"
          class="brand-orb-button"
          data-theme-toggle
          type="button"
        >
          <span class="brand-orb h-4 w-4 flex-none rounded-full" aria-hidden="true"></span>
        </button>
        <a class="site-brand text-lg font-semibold leading-none tracking-[-0.03em]" href="/">
          <span class="lg:hidden">{site.name}</span>
          <span class="hidden lg:inline">Michael</span>
        </a>
      </div>

      <nav class="overflow-x-auto lg:overflow-visible" aria-label="Primary">
        <ul class="site-nav-list flex items-center gap-4 text-sm font-semibold lg:flex-col lg:items-stretch lg:gap-3 lg:text-[1.02rem]">
          {
            navigation.map((link) => (
              <li>
                <a
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'site-nav-link group inline-flex items-center gap-2 whitespace-nowrap transition-colors duration-200 focus-visible:outline-none lg:grid lg:w-full lg:grid-cols-[0.65rem_minmax(0,1fr)] lg:gap-2 lg:py-1.5 lg:text-left',
                    isActive(link.href) && 'is-active'
                  ]}
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noreferrer' : undefined}
                >
                  <span
                    class:list={[
                      'site-nav-dot hidden h-2 w-2 self-center rounded-full lg:block lg:opacity-0 lg:transition-opacity lg:duration-200',
                      isActive(link.href) && 'lg:opacity-100'
                    ]}
                    aria-hidden="true"
                  ></span>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</header>
