---
import Container from '../Container.astro';
import { navigation, site } from '../../data/site';

interface Props {
  pathname?: string;
}

const { pathname = '/' } = Astro.props as Props;

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-30 border-b border-line/70 bg-paper/90 backdrop-blur-sm">
  <Container>
    <div class="flex items-center justify-between gap-6 py-6">
      <a class="text-[0.78rem] font-medium uppercase tracking-[0.24em] text-ink" href="/">
        {site.name}
      </a>

      <nav aria-label="Primary">
        <ul class="flex items-center gap-5 text-sm text-muted sm:gap-8">
          {
            navigation.map((link) => (
              <li>
                <a
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'transition-colors duration-200 hover:text-ink',
                    isActive(link.href) && 'text-ink'
                  ]}
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</header>
