---
import Container from '../Container.astro';
import { navigation, site } from '../../data/site';

interface Props {
  pathname?: string;
}

const { pathname = '/' } = Astro.props as Props;

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line/60 bg-paper/88 backdrop-blur-md lg:inset-auto lg:left-6 lg:top-6 lg:w-[132px] lg:rounded-xl lg:border lg:border-paper/5 lg:bg-night/0 lg:text-paper lg:shadow-none lg:transition-all lg:duration-300 lg:hover:border-paper/10 lg:hover:bg-night/92 lg:hover:shadow-2xl lg:hover:shadow-night/20 lg:focus-within:border-paper/10 lg:focus-within:bg-night/92">
  <Container class="lg:px-0">
    <div class="flex min-h-16 items-center justify-between gap-4 py-3 lg:min-h-0 lg:flex-col lg:items-start lg:gap-4 lg:p-4">
      <a class="flex items-center gap-2 text-lg font-semibold leading-none tracking-[-0.03em] text-ink lg:text-paper" href="/">
        <span class="h-4 w-4 rounded-full bg-[radial-gradient(circle_at_35%_35%,#f8d75d,#ff5546_52%,#3d7b51)]" aria-hidden="true"></span>
        <span class="lg:hidden">{site.name}</span>
        <span class="hidden lg:inline">Michael</span>
      </a>

      <nav class="overflow-x-auto lg:overflow-visible" aria-label="Primary">
        <ul class="flex items-center gap-4 text-sm font-semibold text-muted lg:flex-col lg:items-start lg:gap-2 lg:text-[1.02rem] lg:text-paper/48">
          {
            navigation.map((link) => (
              <li>
                <a
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  class:list={[
                    'group inline-flex items-center gap-2 whitespace-nowrap transition-colors duration-200 hover:text-ink focus-visible:text-ink focus-visible:outline-none lg:hover:text-paper lg:focus-visible:text-paper',
                    isActive(link.href) && 'text-ink lg:text-paper'
                  ]}
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noreferrer' : undefined}
                >
                  <span
                    class:list={[
                      'hidden h-2 w-2 rounded-full bg-accent lg:inline-block lg:opacity-0 lg:transition-opacity lg:duration-200',
                      isActive(link.href) && 'lg:opacity-100'
                    ]}
                    aria-hidden="true"
                  ></span>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>
</header>
