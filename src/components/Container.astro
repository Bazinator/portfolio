---
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
  narrow?: boolean;
}

const {
  as: Element = 'div',
  class: className = '',
  narrow = false
} = Astro.props;

const widthClass = narrow ? 'max-w-[760px]' : 'max-w-[1000px]';
---

<Element class:list={['mx-auto w-full px-6 sm:px-8 lg:px-10', widthClass, className]}>
  <slot />
</Element>
