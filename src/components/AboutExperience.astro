---
import Container from './Container.astro';
import { aboutFocus, aboutNarrative, principles, site } from '../data/site';
---

<section class="about-intro relative min-h-[170svh]" data-about-intro>
  <div class="sticky top-0 flex min-h-svh items-center justify-center overflow-hidden">
    <div class="about-intro-backdrop absolute inset-0"></div>
    <div class="vitruvian-stage relative flex aspect-square w-[min(82vw,620px)] items-center justify-center" data-vitruvian-stage>
      <img
        alt="Leonardo da Vinci's Vitruvian Man"
        class="h-full w-full object-contain transition-opacity duration-150"
        style="opacity: calc(0.92 - var(--about-progress, 0) * 0.52)"
        src="/images/leonardo-da-vinci-vitruvian-man-2.jpg"
      />
      <h1 class="about-title absolute inset-x-0 top-1/2 mx-auto max-w-[12ch] -translate-y-1/2 text-center text-[clamp(3.2rem,10vw,7.8rem)] font-semibold leading-[0.86] tracking-[-0.055em]">
        {site.name}
      </h1>
    </div>
    <div class="about-intro-fade pointer-events-none absolute inset-0 opacity-[var(--about-progress,0)] transition-opacity duration-150"></div>
  </div>
</section>

<section class="dark-section dark-rule -mt-[70svh] relative z-10 border-t py-16 sm:py-20">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(260px,0.65fr)] lg:gap-14">
      <div class="space-y-8">
        <div class="max-w-3xl space-y-5">
          <p class="editorial-label">About</p>
          <h2 class="section-title">I am trying to become the kind of builder who can be trusted with real problems.</h2>
          <p class="body-large">{site.role}</p>
        </div>

        <article class="prose-editorial max-w-3xl">
          {aboutNarrative.map((paragraph) => <p>{paragraph}</p>)}
        </article>
      </div>

      <aside class="space-y-8">
        <figure class="dark-rule overflow-hidden border">
          <img
            alt="Michael's desk setup"
            class="aspect-[4/5] h-full w-full object-cover"
            loading="lazy"
            src="/images/personal/deskSetup.JPG"
          />
        </figure>
        <div class="grid grid-cols-2 gap-3">
          <img
            alt="SFU campus in snow"
            class="aspect-square h-full w-full object-cover"
            loading="lazy"
            src="/images/personal/snowySFU.JPG"
          />
          <img
            alt="A mountain trail and lake"
            class="aspect-square h-full w-full object-cover"
            loading="lazy"
            src="/images/personal/heatherTrailLake.JPG"
          />
        </div>
      </aside>
    </div>

    <div class="dark-rule mt-14 grid gap-8 border-t pt-10 md:grid-cols-2">
      <div class="space-y-4">
        <p class="editorial-label">Focus</p>
        <ul class="space-y-3 text-sm leading-7">
          {aboutFocus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="space-y-4">
        <p class="editorial-label">Principles</p>
        <ul class="space-y-3 text-sm leading-7">
          {principles.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </Container>
</section>

<script>
  const intro = document.querySelector<HTMLElement>('[data-about-intro]');
  const stage = document.querySelector<HTMLElement>('[data-vitruvian-stage]');

  const updateAboutProgress = () => {
    if (!intro || !stage) return;
    const rect = intro.getBoundingClientRect();
    const scrollable = Math.max(1, rect.height - window.innerHeight);
    const progress = Math.min(1, Math.max(0, -rect.top / scrollable));
    stage.style.setProperty('--about-progress', progress.toFixed(3));
  };

  updateAboutProgress();
  window.addEventListener('scroll', updateAboutProgress, { passive: true });
  window.addEventListener('resize', updateAboutProgress);
</script>
