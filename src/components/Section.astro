---
import Container from './Container.astro';

interface Props {
  id?: string;
  class?: string;
  intro?: string;
  narrow?: boolean;
  title?: string;
}

const {
  id,
  class: className = '',
  intro,
  narrow = false,
  title
} = Astro.props;
---

<section id={id} class:list={['py-24 sm:py-28', className]}>
  <Container narrow={narrow}>
    {
      (title || intro) && (
        <div class="mb-14 max-w-2xl">
          {title && <h2 class="section-title">{title}</h2>}
          {intro && <p class="mt-5 body-large">{intro}</p>}
        </div>
      )
    }
    <slot />
  </Container>
</section>
