---
import type { CollectionEntry } from 'astro:content';
import { projectPath } from '../lib/content';

type ProjectEntry = CollectionEntry<'projects'>;

interface Props {
  href?: string;
  index?: number;
  project: ProjectEntry;
  reversed?: boolean;
}

const {
  href,
  index = 0,
  project,
  reversed = index % 2 === 1
} = Astro.props as Props;

const projectHref = href ?? projectPath(project);
const projectLinks = project.data.links;
---

<article class="group border-t pt-9 first:pt-0">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12">
    <div class:list={['space-y-5', reversed && 'lg:order-2']}>
      <p class="editorial-label">
        {String(index + 1).padStart(2, '0')}
      </p>
      <div class="space-y-3">
        <h3 class="text-2xl font-semibold leading-tight tracking-[-0.035em] sm:text-3xl">
          <a class="hover:text-[var(--theme-muted)]" href={projectHref}>
            {project.data.title}
          </a>
        </h3>
        <p class="body-large max-w-xl">{project.data.description}</p>
      </div>
      {(projectLinks.github || projectLinks.demo) && (
        <div class="flex flex-wrap gap-3">
          {projectLinks.github && (
            <a
              class="btn btn-secondary"
              href={projectLinks.github}
              rel="noreferrer"
              target="_blank"
            >
              GitHub
            </a>
          )}
          {projectLinks.demo && (
            <a
              class="btn btn-primary"
              href={projectLinks.demo}
              rel="noreferrer"
              target="_blank"
            >
              Live Demo
            </a>
          )}
        </div>
      )}
      <ul class="meta-list">
        {project.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <a
        class="text-action transition-transform duration-300 hover:translate-x-1"
        href={projectHref}
      >
        View Case Study
        <span class="action-mark" aria-hidden="true">/</span>
      </a>
    </div>

    <a
      class:list={[
        'visual-treatment border transition-transform duration-500 hover:-translate-y-1',
        reversed ? 'lg:order-1' : 'lg:order-2'
      ]}
      href={projectHref}
    >
      <img
        alt={`${project.data.title} project preview`}
        class="aspect-[16/10] h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
        loading="lazy"
        src={project.data.image}
      />
    </a>
  </div>
</article>
