---
import BaseLayout from '../components/layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { referenceLinks } from '../data/site';

const groups = Object.entries(
  referenceLinks.reduce<Record<string, typeof referenceLinks>>((acc, link) => {
    acc[link.category] ??= [];
    acc[link.category].push(link);
    return acc;
  }, {})
);
---

<BaseLayout description="Internet references, tools, and reading links saved by Michael Bazett." title="Links">
  <section class="border-b border-line/70 pt-28 pb-14 sm:pt-32 sm:pb-16">
    <Container>
      <div class="max-w-3xl space-y-5">
        <p class="editorial-label">Links</p>
        <h1 class="page-title">References worth keeping close.</h1>
        <p class="body-large">
          A small shelf for documentation, reading, and useful internet landmarks.
        </p>
      </div>
    </Container>
  </section>

  <section class="py-14 sm:py-16">
    <Container>
      <div class="space-y-12">
        {
          groups.map(([category, links]) => (
            <section class="grid gap-5 border-t border-line/80 pt-6 lg:grid-cols-[180px_minmax(0,1fr)] lg:gap-10">
              <h2 class="editorial-label pt-1">{category}</h2>
              <ul class="space-y-0 border-y border-line/70">
                {links.map((link) => (
                  <li class="border-b border-line/70 py-5 last:border-b-0">
                    <a
                      class="group grid gap-2 sm:grid-cols-[minmax(0,0.45fr)_minmax(0,0.55fr)] sm:gap-8"
                      href={link.url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      <span class="text-xl font-semibold tracking-[-0.025em] text-ink group-hover:text-accent">
                        {link.title}
                      </span>
                      <span class="flex items-start justify-between gap-4 text-sm leading-6 text-muted">
                        {link.note}
                        <span class="mt-0.5 text-accent" aria-hidden="true">/</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>
