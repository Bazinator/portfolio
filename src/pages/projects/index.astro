---
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { getAllProjects } from '../../lib/content';

const projects = await getAllProjects();
---

<BaseLayout description="Selected projects across software systems, civic data, web tools, and applied technical work." title="Projects">
  <section class="page-hero">
    <Container>
      <div class="max-w-3xl space-y-5">
        <p class="editorial-label">Projects</p>
        <h1 class="page-title">My Creations</h1>
        <p class="body-large">
          A short write up of some of my projects.
        </p>
      </div>
    </Container>
  </section>

  <section class="py-14 sm:py-16">
    <Container>
      <div class="space-y-12 sm:space-y-14">
        {projects.map((project, index) => <ProjectRow index={index} project={project} />)}
      </div>
    </Container>
  </section>
</BaseLayout>
