---
import BaseLayout from '../components/layouts/BaseLayout.astro';
import BlogList from '../components/BlogList.astro';
import Container from '../components/Container.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Section from '../components/Section.astro';
import { homeSnapshot, site } from '../data/site';
import { getFeaturedProjects, getLatestPosts } from '../lib/content';

const [featuredProjects, latestPosts] = await Promise.all([
  getFeaturedProjects(3),
  getLatestPosts(3)
]);
---

<BaseLayout title="Portfolio">
  <section class="relative flex min-h-[82svh] items-end overflow-hidden border-b border-line/70 bg-night px-0 pt-24 text-paper">
    <div class="absolute inset-0 visual-treatment" aria-hidden="true">
      <img class="h-full w-full object-cover opacity-35" src="/images/leonardo.jpg" alt="" />
    </div>
    <Container>
      <div class="relative z-10 max-w-4xl pb-14 sm:pb-16">
        <p class="editorial-label mb-5 text-paper/62">Portfolio / Software Systems</p>
        <h1 class="text-balance text-[clamp(4rem,12vw,8.5rem)] font-semibold leading-[0.88] tracking-[-0.06em] text-paper">
          {site.name}
        </h1>
        <p class="mt-6 max-w-2xl text-pretty text-lg leading-[1.6] text-paper/72 sm:text-xl">
          {site.subtitle}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="border border-paper/20 px-4 py-2 text-sm font-semibold text-paper transition-colors hover:border-accent hover:text-accent" href="/projects">
            Projects
          </a>
          <a class="border border-paper/20 px-4 py-2 text-sm font-semibold text-paper transition-colors hover:border-accent hover:text-accent" href="/writing">
            Writing
          </a>
        </div>
      </div>
    </Container>
  </section>

  <Section
    id="snapshot"
    intro="A tighter view of the work, experience, and focus shaping the practice."
    title="Now"
  >
    <ul class="border-y border-line/80">
      {
        homeSnapshot.map((item) => (
          <li class="grid gap-4 border-b border-line/80 py-6 last:border-b-0 lg:grid-cols-[180px_minmax(0,1fr)] lg:gap-8">
            <p class="editorial-label">{item.label}</p>
            <p class="max-w-3xl">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    id="featured-work"
    intro="Selected projects, kept compact and readable until the images are ready to carry more of the page."
    title="Projects"
  >
    <div class="space-y-12 sm:space-y-14">
      {featuredProjects.map((project, index) => <ProjectRow index={index} project={project} />)}
    </div>
  </Section>

  <Section
    id="writing"
    class="border-t border-line/70"
    intro="Short essays and notes on systems, interfaces, and the process of getting better at building."
    title="Writing"
  >
    <BlogList posts={latestPosts} />
  </Section>
</BaseLayout>
